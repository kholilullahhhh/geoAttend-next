# ---------------------------------------------------------------------------
# GeoAttend dashboard — environment variables
#
# Copy to `.env.local` and fill in the values. NEVER commit `.env.local`.
# `.env.local` is already listed in .gitignore.
#
# SECURITY: only the **anon / publishable** key belongs here. It is designed to
# be shipped to clients — Row Level Security is what protects the data. A
# service-role key in this file would bypass every policy in
# supabase/migrations/..._rls_policies.sql and must never be used by this app.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (the "anon" role key from Project Settings → API).
# Do NOT paste the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=